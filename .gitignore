# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local HTTPS certificates (next dev --experimental-https)
/certificates/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# parallel phase worktrees (D-35)
.claude/worktrees/

# third-party hackathon material, not published with the repo
/docs/00_originals/

# Workflow SDK (withWorkflow): generated routes, SWC plugin cache, local run data
/app/.well-known/workflow/
/.swc
/.workflow-data/
